{
  "name": "custom-flat-pack-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Custom flat-pack furniture platform: constrained configurator, deterministic engineering kernel, order and production release workflow.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev": "npm run dev --workspace @cfp/web",
    "start": "npm run start --workspace @cfp/web"
  },
  "engines": {
    "node": ">=20"
  }
}
