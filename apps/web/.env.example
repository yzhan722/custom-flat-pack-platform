# Leave DATABASE_URL empty to use the embedded PGlite database in apps/web/.data/pglite (zero install).
# Set it to a PostgreSQL connection string for a shared/production database.
DATABASE_URL=

# Back-office login. Change both before exposing the app beyond localhost.
ADMIN_PASSWORD=change-me
AUTH_SECRET=replace-with-a-long-random-string

# Optional: name shown as the selling entity on quotes and confirmations.
SELLER_NAME=Custom Flat-Pack Pilot
